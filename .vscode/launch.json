{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Windows Debug navkit_sim",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/debug/apps/navkit_sim/StationaryGnss/apps/navkit_sim/navkit_sim.exe",
            "args": [
                "${workspaceFolder}/config/runtime/navkit_sim/stationary_gnss.json"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        },
        {
            "name": "Windows Debug navkit_tests",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/debug/apps/navkit_sim/StationaryGnss/tests/navkit_tests.exe",
            "args": [],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        },
        {
            "name": "Linux Debug navkit_sim",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/debug/apps/navkit_sim/StationaryGnss/apps/navkit_sim/navkit_sim",
            "args": [
                "${workspaceFolder}/config/runtime/navkit_sim/stationary_gnss.json"
            ],
            "cwd": "${workspaceFolder}",
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "console": "integratedTerminal"
        },
        {
            "name": "Linux Debug navkit_tests",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/debug/apps/navkit_sim/StationaryGnss/tests/navkit_tests",
            "args": [],
