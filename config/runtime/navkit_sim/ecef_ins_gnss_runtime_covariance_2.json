{
  "components": {
    "trajectory": "components/trajectory/stationary_ecef_1000hz.json",
    "imu": "components/imu/specs/hg1700_tactical.json",
    "gnss": "components/gnss/nominal_pos_vel.json",
    "process_noise": "components/propagation/default_ecef_ins_process_noise.json",
    "imu_bias_dynamics": "components/propagation/default_gauss_markov_imu_bias_dynamics.json",
    "pva_initialization": "components/initialization/pva/pva_random_error_default.json",
    "filter_initialization": "components/initialization/filter/default_ins_statedef_initial_covariance.json",
    "covariance_floor": "components/initialization/filter/default_ins_statedef_covariance_floor.json"
  },
  "run_name": "ecef_ins_gnss_runtime_covariance",
  "output_dir": "output/logs/ecef_ins_gnss_runtime_covariance",
