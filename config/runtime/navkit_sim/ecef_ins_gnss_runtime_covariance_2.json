    },
    "imu": {
      "enabled": true,
      "rate_hz": 100.0
    },
    "imu_debug": {
      "enabled": false
    },
    "filter_correction": {
      "enabled": true,
      "rate_hz": 10.0,
      "covariance": "diagonal"
    },
    "measurement_statistics": {
      "enabled": true,
      "rate_hz": 1.0
    }
  }
}
